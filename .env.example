# MongoDB Connection (Local or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=threat_intelligence

# Optional AI Analysis (Gemini / OpenAI API keys)
# If left blank, the built-in Cyber Threat Intelligence Expert Heuristic Engine will be used automatically.
GEMINI_API_KEY=
OPENAI_API_KEY=

# Demo mode: allow dashboard "Trigger Live Attack" simulation to appear in the live feed.
# Set to false in production to accept real honeypot telemetry only.
ALLOW_SIMULATION_EVENTS=true

# Key for POST /api/admin/purge-demo (optional)
ADMIN_PURGE_KEY=kurukshetra-purge-demo
